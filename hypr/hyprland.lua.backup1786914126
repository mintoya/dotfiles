local hl = hl
local pass, colors = pcall(require, "colors")
if not pass then
  colors = { secondary_container = "#ff0000", }
  hl.exec_cmd("notify-send -u=critical 'config error' 'couldnt find color file for hyprland config'")
end


local mainmod = "ALT"
local terminal = "ghostty"
local fileManager = "thunar"
local browser = "zen-browser"
local menu = "dms ipc launcher open"

hl.monitor({
  output = "eDP-1",
  mode = "preferred",
  position = "auto",
  scale = 1.57,
})

hl.on("hyprland.start", function()
  hl.exec_cmd("dms run")
end)

hl.config({
  general = {

    gaps_in = 2,
    gaps_out = 10,

    border_size = 2,
    col = {
      active_border = colors.secondary_container .. "ff",
      inactive_border = "#00000000",
    },
  },
  decoration = {
    rounding = 20,
    active_opacity = 1,
    inactive_opacity = 0.5,

    shadow = {
      enabled = false,
    },

    blur = {
      enabled = true,
      noise = 0.05,
      size = 6,
      passes = 3,
      vibrancy = 0.8,
    },
  },
})

do -- animation
  hl.config({ animations = { enabled = true } })
  hl.curve("easeOutQuint", { type = "bezier", points = { { 0.23, 1 }, { 0.32, 1 } } })
  hl.curve("easeInOutCubic", { type = "bezier", points = { { 0.65, 0.05 }, { 0.36, 1 } } })
  hl.curve("linear", { type = "bezier", points = { { 0, 0 }, { 1, 1 } } })
  hl.curve("almostLinear", { type = "bezier", points = { { 0.5, 0.5 }, { 0.75, 1.0 } } })
  hl.curve("quick", { type = "bezier", points = { { 0.15, 0 }, { 0.1, 1 } } })

  hl.animation({ leaf = "global", enabled = true, speed = 10, bezier = "default" })
  hl.animation({ leaf = "border", enabled = true, speed = 5.39, bezier = "easeOutQuint" })
  hl.animation({ leaf = "windows", enabled = true, speed = 4.79, bezier = "easeOutQuint" })
  hl.animation({ leaf = "windowsIn", enabled = true, speed = 4.1, bezier = "easeOutQuint", style = "popin 87%" })
  hl.animation({ leaf = "windowsOut", enabled = true, speed = 1.49, bezier = "linear", style = "popin 87%" })
  hl.animation({ leaf = "fadeIn", enabled = true, speed = 1.73, bezier = "almostLinear" })
  hl.animation({ leaf = "fadeOut", enabled = true, speed = 1.46, bezier = "almostLinear" })
  hl.animation({ leaf = "fade", enabled = true, speed = 3.03, bezier = "quick" })
  hl.animation({ leaf = "layers", enabled = true, speed = 3.81, bezier = "easeOutQuint" })
  hl.animation({ leaf = "layersIn", enabled = true, speed = 4, bezier = "easeOutQuint", style = "fade" })
  hl.animation({ leaf = "layersOut", enabled = true, speed = 1.5, bezier = "linear", style = "fade" })
  hl.animation({ leaf = "fadeLayersIn", enabled = true, speed = 1.79, bezier = "almostLinear" })
  hl.animation({ leaf = "fadeLayersOut", enabled = true, speed = 1.39, bezier = "almostLinear" })
  hl.animation({ leaf = "workspacesIn", enabled = true, speed = 1.21, bezier = "almostLinear", style = "slidefade" })
  hl.animation({ leaf = "workspacesOut", enabled = true, speed = 1.94, bezier = "almostLinear", style = "slidefade" })
end
do -- keybinds
  local binds = {
    { keys = { mainmod, "Return" },          action = hl.dsp.exec_cmd(terminal) },
    { keys = { mainmod, "B" },               action = hl.dsp.exec_cmd(browser) },
    { keys = { mainmod, "E" },               action = hl.dsp.exec_cmd(fileManager) },
    { keys = { mainmod, "R" },               action = hl.dsp.exec_cmd(menu) },
    { keys = { mainmod, "Q" },               action = hl.dsp.window.close() },
    { keys = { mainmod, "M" },               action = hl.dsp.exit() },
    { keys = { mainmod, "V" },               action = hl.dsp.window.float({ action = "toggle" }) },

    { keys = { mainmod, "up", },             action = hl.dsp.focus({ direction = "up" }) },
    { keys = { mainmod, "left", },           action = hl.dsp.focus({ direction = "left" }) },
    { keys = { mainmod, "down", },           action = hl.dsp.focus({ direction = "down" }) },
    { keys = { mainmod, "right", },          action = hl.dsp.focus({ direction = "right" }) },

    { keys = { mainmod, "SHIFT", "up", },    action = hl.dsp.window.move({ direction = "up" }) },
    { keys = { mainmod, "SHIFT", "left", },  action = hl.dsp.window.move({ direction = "left" }) },
    { keys = { mainmod, "SHIFT", "down", },  action = hl.dsp.window.move({ direction = "down" }) },
    { keys = { mainmod, "SHIFT", "right", }, action = hl.dsp.window.move({ direction = "right" }) },

    { keys = { mainmod, "h", },              action = hl.dsp.focus({ direction = "left" }) },
    { keys = { mainmod, "j", },              action = hl.dsp.focus({ direction = "down" }) },
    { keys = { mainmod, "k", },              action = hl.dsp.focus({ direction = "up" }) },
    { keys = { mainmod, "l", },              action = hl.dsp.focus({ direction = "right" }) },

    { keys = { mainmod, "SHIFT", "h", },     action = hl.dsp.window.move({ direction = "left" }) },
    { keys = { mainmod, "SHIFT", "j", },     action = hl.dsp.window.move({ direction = "down" }) },
    { keys = { mainmod, "SHIFT", "k", },     action = hl.dsp.window.move({ direction = "up" }) },
    { keys = { mainmod, "SHIFT", "l", },     action = hl.dsp.window.move({ direction = "right" }) },
  }
  for _, bind in pairs(binds) do
    hl.bind(table.concat(bind.keys, " + "), bind.action)
  end

  for i = 1, 9 do
    hl.bind(mainmod .. " + " .. tostring(i), hl.dsp.focus({ workspace = tostring(i) }))
    hl.bind(mainmod .. " + SHIFT + " .. tostring(i), hl.dsp.window.move({ workspace = tostring(i) }))
  end
  hl.bind(mainmod .. " + 0", hl.dsp.focus({ workspace = 10 }))
  hl.bind(mainmod .. " + SHIFT + 0", hl.dsp.window.move({ workspace = 10 }))

  hl.bind(mainmod .. " + mouse:272", hl.dsp.window.drag(), { mouse = true })
  hl.bind(mainmod .. " + mouse:273", hl.dsp.window.resize(), { mouse = true })
end
do -- other binds
  hl.bind(
    "XF86AudioRaiseVolume",
    hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+"),
    { repeating = true, locked = true }
  )
  hl.bind(
    "XF86AudioLowerVolume",
    hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"),
    { repeating = true, locked = true }
  )
  hl.bind("XF86AudioMute", hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"), { locked = true })
  hl.bind("XF86AudioMicMute", hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"), { locked = true })
  hl.bind("XF86MonBrightnessUp", hl.dsp.exec_cmd("brightnessctl s 10%+"), { repeating = true, locked = true })
  hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("brightnessctl s 10%-"), { repeating = true, locked = true })

  hl.bind(mainmod .. " + S", hl.dsp.exec_cmd("hyprshot -m region"), { locked = true })
  hl.bind("XF86AudioNext", hl.dsp.exec_cmd("playerctl next"), { locked = true })
  hl.bind("XF86AudioPause", hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
  hl.bind("XF86AudioPlay", hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
  hl.bind("XF86AudioPrev", hl.dsp.exec_cmd("playerctl previous"), { locked = true })
end
